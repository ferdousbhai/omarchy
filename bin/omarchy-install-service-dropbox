#!/bin/bash

# omarchy:summary=Install and start the Dropbox service. Must then be authenticated via the web.

echo "Installing all dependencies..."
if [[ $(uname -m) == "aarch64" ]]; then
  # Dropbox only ships an x86_64 client. The ARM package runs it under box64,
  # and both live in the official edge repository, which Apple Silicon keeps
  # at Usage = Sync, so they have to be requested from it by name. Plain names
  # pass omarchy-pkg-add's availability check (pacman -Si sees that repository)
  # and then fail in pacman -S with "target not found".
  box64_present=0
  if omarchy-pkg-present box64; then
    box64_present=1
  fi

  omarchy-pkg-add omarchy/box64 omarchy/dropbox omarchy/dropbox-cli python-gpgme omarchy/nautilus-dropbox || exit 1

  # box64 is only here for Dropbox: record it as a dependency so removing
  # Dropbox takes it along, unless it was already installed for something else.
  if (( ! box64_present )); then
    sudo pacman -D --asdeps box64 >/dev/null
  fi
else
  omarchy-pkg-add dropbox dropbox-cli libappindicator-gtk3 python-gpgme nautilus-dropbox || exit 1
fi

echo "Adding Dropbox to the bar..."
omarchy-plugin-enable omarchy.dropbox

echo "Starting Dropbox..."
uwsm-app -- dropbox-cli start &>/dev/null &
echo "See Dropbox icon behind  hover tray in top right and right-click for setup."
