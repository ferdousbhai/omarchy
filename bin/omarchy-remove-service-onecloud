#!/bin/bash

# omarchy:summary=Remove OneCloud, leaving your files and your bucket as they are.
# omarchy:requires-sudo=true

systemctl --user stop onecloud 2>/dev/null || true
omarchy-pkg-drop onecloud

echo ""
echo "OneCloud has been removed."
echo "Your files stay in your folders and in your bucket, and ~/.config/onecloud keeps this computer's setup."
