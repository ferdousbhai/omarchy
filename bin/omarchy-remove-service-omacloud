#!/bin/bash

# omarchy:summary=Remove Omacloud, leaving your files and your storage as they are.
# omarchy:requires-sudo=true

set -e

systemctl --user disable --now omacloud 2>/dev/null || true
if ! omarchy-pkg-drop omacloud; then
  # Still installed: turn sync back on rather than leave it off.
  systemctl --user enable --now omacloud 2>/dev/null || true
  exit 1
fi

echo ""
echo "Omacloud has been removed."
echo "Your files stay in your folders and in your storage, and ~/.config/omacloud keeps this computer's setup."
